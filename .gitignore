# secrets — never commit
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# frontend QA artifacts (screenshots and JSON reports are regenerated by
# scripts in frontend/qa). 커밋된 실행 산출물은 코드가 바뀌면 조용히 거짓이 된다 —
# final_report.json 이 삭제된 프론트 로컬 사본의 답(권장액 75만)을 보존하고 있었다.
frontend/qa/*.png
frontend/qa/*_report.json

# 2026 예선 제출 기록 — 디스크에는 보관하되 버전관리 대상에서 제외 (약 33MB)
archive/

# local tooling
.impeccable/
*.tmp

# 저장소 런타임 산출물 — DEFAULT_STORE_URL 이 backend/var/home_compass.db 다 (W-store 요청)
backend/var/
*.db
