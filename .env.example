# Home_Compass — 환경변수 템플릿
#
# 이 파일을 리포지토리 루트에 `.env` 로 복사해서 사용하세요.
#   copy .env.example .env
#
# ★ 키가 없어도 시민 분석·정책 판정·리스크 계산과 운영 화면은 동작합니다.
#   AI 상담은 규칙 기반 한국어 템플릿(offline 모드)으로 응답합니다.
#   실데이터 수집과 LLM 기반 정책 추출에는 아래의 해당 키가 필요합니다.
#
# 프로바이더 우선순위: OPENAI_API_KEY > ANTHROPIC_API_KEY > offline

# 1순위 — OpenAI (function calling)
OPENAI_API_KEY=

# 사용할 OpenAI 모델. 비워두면 gpt-5.4-mini 를 사용합니다.
OPENAI_MODEL=

# 2순위 — Anthropic (tool use)
ANTHROPIC_API_KEY=

# 사용할 Anthropic 모델. 비워두면 claude-sonnet-5 를 사용합니다.
ANTHROPIC_MODEL=

# 공개 HTTPS 배포에서만 true. 로컬 http://127.0.0.1 실행은 false를 유지합니다.
HOME_COMPASS_COOKIE_SECURE=false

# 값을 붙여넣을 때 따옴표나 홑화살괄호(<>)가 섞여 들어가도 자동으로 제거됩니다.
#   OPENAI_API_KEY=<sk-proj-...>  ->  sk-proj-... 로 정상 인식

# ── 국토교통부 실거래가 오픈API (SPEC 3단계 시세 수집) ──────────────────────
# 공공데이터포털은 **계정당 인증키 하나**를 준다. 서비스별로 갈리는 것은 키가 아니라
# 활용신청이므로, 아래 둘을 각각 신청하고 키는 하나만 넣으면 된다.
#
#   아파트 전월세 실거래가 자료   https://www.data.go.kr/data/15126474/openapi.do
#   아파트 매매   실거래가 자료   https://www.data.go.kr/data/15126469/openapi.do
#
# 이용조건은 실사에서 원문확인됐다 — 이용허락범위 제한 없음 / 무료 / 자동승인.
#
# ★ Encoding·Decoding 어느 형태를 넣어도 된다. 코드가 정규화한다
#   (source.normalise_service_key). 포털 키는 base64 라 `%` 가 곧 인코딩되었다는 뜻이다.
MOLIT_API_KEY=
